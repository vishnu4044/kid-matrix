FLASK_ENV=development
SECRET_KEY=
JWT_SECRET_KEY=

DATABASE_URL=sqlite:///../data/kid_matrix.db

OPENAI_API_KEY=

FAISS_INDEX_PATH=../data/faiss
UPLOAD_DIR=../uploads

CORS_ORIGINS=http://localhost:5173
# To test from an iPad/phone on the same WiFi, add your machine's LAN IP too,
# e.g. CORS_ORIGINS=http://localhost:5173,http://192.168.1.42:5173
# (find your IP with `ipconfig getifaddr en0` on macOS), and point
# frontend/.env's VITE_API_BASE_URL at that same IP instead of 127.0.0.1.